# ============ LLM（生成脚本 / 应对打断）============
# 默认 OpenAI 兼容协议：豆包/GLM/DeepSeek/mimo/OpenAI 均可，只需改 base_url+key+model
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini

# ============ TTS（语音合成，可插拔）============
# 开箱即用：TTS_PROVIDER=edge 免 key，下面是 edge 默认中文音色
# 切到 mimo：把 TTS_PROVIDER 改成 mimo，填 MIMO key，并把两个 voice 改成 mimo 音色（如 Chloe）
TTS_PROVIDER=edge
TTS_BASE_URL=https://api.xiaomimimo.com/v1
TTS_API_KEY=
TTS_MODEL=mimo-v2.5-tts
TTS_VOICE_HOST=zh-CN-XiaoxiaoNeural
TTS_VOICE_COHOST=zh-CN-YunxiNeural
TTS_AUDIO_FORMAT=wav

# ============ 播客默认参数 ============
PODCAST_NUM_SEGMENTS=8
PODCAST_HOST_NAME=主持人
PODCAST_COHOST_NAME=嘉宾

# ============ 服务 ============
HOST=0.0.0.0
PORT=8000
